# === MEMORY RING v3.3 CONFIGURATION ===

# --- HARDWARE PROFILE ---
NODE_MODE=core
PORT=3141

# --- THE BRAIN ---

# === PATH A: SOVEREIGN (Local Ollama) ===
LLM_PROVIDER=ollama
# The /v1 is required for OpenAI-adapter compatibility
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3
VISION_MODEL=llava:7b

# === PATH B: CLOUD API (OpenAI) ===
# Set LLM_PROVIDER explicitly. Without it the transport is inferred from the
# base URL, and a remote host is assumed to be OpenAI-compatible.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-gpt-model-here
# OPENAI_API_KEY=sk-your-key-here

# === PATH B: CLOUD API (Anthropic via Proxy) ===
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/your-claude-model-here
# OPENAI_API_KEY=your-proxy-key-here

# Path B note: repeat_penalty and num_ctx are Ollama-only — the OpenAI schema
# has no equivalent field, so they are not sent. Statelessness is unaffected;
# the adapter never transmits history, only the system prompt and the current
# turn. A failed or unauthorised call is logged to the console AND the memory
# it produces is tagged `suspect`, so it cannot enter the ring as testimony.

# SENSORY SETTINGS (For Action Phase)
VISION_BACKEND=local
SENSORY_IMPORTANCE=1.2
DELTA_THRESHOLD=0.15

# --- THE WAREHOUSE ---
# Use absolute path if you plan to move the folder later
DATA_PATH=./data

# === SECURITY (Optional but Recommended) ===
# If set, all /api endpoints require this key in the x-api-key header.
# If not set, API endpoints are open (suitable for local-only use).
# MR_API_KEY=your-secret-key-here

# If set, network peer handshakes require this shared token.
# If not set, any node can handshake with your instance.
# NETWORK_SECRET=your-shared-network-secret

# === THE EARS (whisper.cpp) ===
WHISPER_PATH=/home/memring/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/home/memring/whisper.cpp/models/ggml-base.en.bin

# === THE VOICE (Piper TTS) ===
PIPER_PATH=/home/memring/piper/piper
PIPER_VOICE=/home/memring/piper/voices/en_GB-alan-medium.onnx

# === THE CHAMBER (Tools/Hands) ===
TOOLS_ENABLED=read,write,list,search,fetch,execute, view

